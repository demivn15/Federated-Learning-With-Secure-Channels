{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fl-benchmark.local/schemas/semi_decentralized/role_assign.json",
  "title": "Asignación de roles de la ronda externa",
  "description": "Coordinador → Client Node. Papel en la ronda (agregador o trabajador), agregador elegido, trabajadores e hiperparámetros. No lleva modelo: el coordinador nunca maneja payloads (RF-03).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "msg_type",
    "experiment_id",
    "topology",
    "sender_id",
    "recipient_id",
    "seq",
    "round",
    "attempt",
    "role",
    "aggregator_id",
    "workers",
    "internal_rounds",
    "training"
  ],
  "properties": {
    "schema_version": {
      "$ref": "../common/definitions.json#/definitions/schema_version"
    },
    "msg_type": {
      "const": "ROLE_ASSIGN"
    },
    "experiment_id": {
      "$ref": "../common/definitions.json#/definitions/experiment_id"
    },
    "topology": {
      "$ref": "../common/definitions.json#/definitions/topology"
    },
    "sender_id": {
      "$ref": "../common/definitions.json#/definitions/node_id"
    },
    "recipient_id": {
      "$ref": "../common/definitions.json#/definitions/recipient_id"
    },
    "seq": {
      "$ref": "../common/definitions.json#/definitions/seq"
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "role": {
      "enum": [
        "aggregator",
        "worker"
      ]
    },
    "aggregator_id": {
      "$ref": "../common/definitions.json#/definitions/node_id"
    },
    "workers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "../common/definitions.json#/definitions/node_id"
      }
    },
    "internal_rounds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "training": {
      "$ref": "../common/definitions.json#/definitions/training_params"
    }
  }
}
