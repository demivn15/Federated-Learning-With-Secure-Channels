{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fl-benchmark.local/schemas/semi_decentralized/election.json",
  "title": "Elección del agregador",
  "description": "Coordinador → Client Node. Abre la elección del intento `attempt` de la ronda externa `round` entre `candidates`. Con `sd_score_hybrid` incluye las puntuaciones; con las loterías, cada nodo usa la semilla compartida del manifiesto (D0 §3.3.3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "msg_type",
    "experiment_id",
    "topology",
    "sender_id",
    "recipient_id",
    "seq",
    "round",
    "attempt",
    "selector",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "$ref": "../common/definitions.json#/definitions/schema_version"
    },
    "msg_type": {
      "const": "ELECTION"
    },
    "experiment_id": {
      "$ref": "../common/definitions.json#/definitions/experiment_id"
    },
    "topology": {
      "$ref": "../common/definitions.json#/definitions/topology"
    },
    "sender_id": {
      "$ref": "../common/definitions.json#/definitions/node_id"
    },
    "recipient_id": {
      "$ref": "../common/definitions.json#/definitions/recipient_id"
    },
    "seq": {
      "$ref": "../common/definitions.json#/definitions/seq"
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "selector": {
      "enum": [
        "lottery_d0",
        "lottery_legacy",
        "round_robin",
        "sd_score_hybrid"
      ]
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "../common/definitions.json#/definitions/node_id"
      }
    },
    "scores": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "../common/definitions.json#/definitions/node_id"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": -100,
        "maximum": 100
      }
    }
  }
}
