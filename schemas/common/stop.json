{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fl-benchmark.local/schemas/common/stop.json",
  "title": "Fin del entrenamiento",
  "description": "El coordinador/servidor/raíz (o un par, en P2P) anuncia el final.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "msg_type",
    "experiment_id",
    "topology",
    "sender_id",
    "recipient_id",
    "seq",
    "round",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "$ref": "definitions.json#/definitions/schema_version"
    },
    "msg_type": {
      "const": "STOP"
    },
    "experiment_id": {
      "$ref": "definitions.json#/definitions/experiment_id"
    },
    "topology": {
      "$ref": "definitions.json#/definitions/topology"
    },
    "sender_id": {
      "$ref": "definitions.json#/definitions/node_id"
    },
    "recipient_id": {
      "$ref": "definitions.json#/definitions/recipient_id"
    },
    "seq": {
      "$ref": "definitions.json#/definitions/seq"
    },
    "round": {
      "$ref": "definitions.json#/definitions/round"
    },
    "reason": {
      "$ref": "definitions.json#/definitions/short_text"
    }
  }
}
