{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fl-benchmark.local/schemas/common/hs_auth.json",
  "title": "Handshake E2E: AUTH (perfil S2)",
  "description": "Firma ECDSA P-256 (r‖s) del emisor sobre el transcript del handshake (identidades, kids, nonces y claves efímeras de ambos). hs_nonce = nonce propio; hs_peer_nonce = nonce del par.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "msg_type", "experiment_id", "topology", "sender_id", "recipient_id", "seq",
               "hs_nonce", "hs_peer_nonce", "hs_sig"],
  "properties": {
    "schema_version": { "$ref": "definitions.json#/definitions/schema_version" },
    "msg_type": { "const": "HS_AUTH" },
    "experiment_id": { "$ref": "definitions.json#/definitions/experiment_id" },
    "topology": { "$ref": "definitions.json#/definitions/topology" },
    "sender_id": { "$ref": "definitions.json#/definitions/node_id" },
    "recipient_id": { "$ref": "definitions.json#/definitions/node_id" },
    "seq": { "$ref": "definitions.json#/definitions/seq" },
    "hs_nonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hs_peer_nonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hs_sig": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
  }
}
