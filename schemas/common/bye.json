{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fl-benchmark.local/schemas/common/bye.json",
  "title": "Salida ordenada",
  "description": "El nodo abandona el experimento.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "msg_type",
    "experiment_id",
    "topology",
    "sender_id",
    "recipient_id",
    "seq"
  ],
  "properties": {
    "schema_version": {
      "$ref": "definitions.json#/definitions/schema_version"
    },
    "msg_type": {
      "const": "BYE"
    },
    "experiment_id": {
      "$ref": "definitions.json#/definitions/experiment_id"
    },
    "topology": {
      "$ref": "definitions.json#/definitions/topology"
    },
    "sender_id": {
      "$ref": "definitions.json#/definitions/node_id"
    },
    "recipient_id": {
      "$ref": "definitions.json#/definitions/recipient_id"
    },
    "seq": {
      "$ref": "definitions.json#/definitions/seq"
    },
    "reason": {
      "$ref": "definitions.json#/definitions/short_text"
    }
  }
}
