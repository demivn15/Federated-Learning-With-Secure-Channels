{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fl-benchmark.local/schemas/common/hs_hello.json",
  "title": "Handshake E2E: HELLO (perfil S2)",
  "description": "Primer mensaje del handshake por par y época (04 §4.6, ADR-05). Va en claro; su autenticidad la da el HS_AUTH, que firma el transcript con estos valores. reply_to = nonce del HELLO al que responde (null si es un inicio).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "msg_type", "experiment_id", "topology", "sender_id", "recipient_id", "seq",
               "hs_kid", "hs_nonce", "hs_epk", "hs_reply_to"],
  "properties": {
    "schema_version": { "$ref": "definitions.json#/definitions/schema_version" },
    "msg_type": { "const": "HS_HELLO" },
    "experiment_id": { "$ref": "definitions.json#/definitions/experiment_id" },
    "topology": { "$ref": "definitions.json#/definitions/topology" },
    "sender_id": { "$ref": "definitions.json#/definitions/node_id" },
    "recipient_id": { "$ref": "definitions.json#/definitions/node_id" },
    "seq": { "$ref": "definitions.json#/definitions/seq" },
    "hs_kid": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "hs_nonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hs_epk": { "description": "Punto P-256 efímero sin comprimir (65 bytes)", "type": "string", "pattern": "^04[0-9a-f]{128}$" },
    "hs_reply_to": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
  }
}
