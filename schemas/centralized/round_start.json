{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fl-benchmark.local/schemas/centralized/round_start.json",
  "title": "Inicio de ronda con el modelo global",
  "description": "Servidor/raíz/agregador → nodo. Lleva el modelo global (payload pickle) y los hiperparámetros de la ronda. `members` (jerárquica): miembros activos del clúster del agregador destinatario.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "msg_type",
    "experiment_id",
    "topology",
    "sender_id",
    "recipient_id",
    "seq",
    "round",
    "training",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "$ref": "../common/definitions.json#/definitions/schema_version"
    },
    "msg_type": {
      "const": "ROUND_START"
    },
    "experiment_id": {
      "$ref": "../common/definitions.json#/definitions/experiment_id"
    },
    "topology": {
      "$ref": "../common/definitions.json#/definitions/topology"
    },
    "sender_id": {
      "$ref": "../common/definitions.json#/definitions/node_id"
    },
    "recipient_id": {
      "$ref": "../common/definitions.json#/definitions/recipient_id"
    },
    "seq": {
      "$ref": "../common/definitions.json#/definitions/seq"
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "training": {
      "$ref": "../common/definitions.json#/definitions/training_params"
    },
    "payload": {
      "$ref": "../common/definitions.json#/definitions/payload_descriptor"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "../common/definitions.json#/definitions/node_id"
      }
    }
  }
}
