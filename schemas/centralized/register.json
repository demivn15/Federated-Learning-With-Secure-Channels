{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fl-benchmark.local/schemas/centralized/register.json",
  "title": "Registro de cliente",
  "description": "Cliente → servidor. Anuncia el nº de entradas y la huella de arquitectura (rechazo temprano de modelos incompatibles, P2-H9).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "msg_type",
    "experiment_id",
    "topology",
    "sender_id",
    "recipient_id",
    "seq",
    "n_features",
    "arch_hash",
    "n_samples"
  ],
  "properties": {
    "schema_version": {
      "$ref": "../common/definitions.json#/definitions/schema_version"
    },
    "msg_type": {
      "const": "REGISTER"
    },
    "experiment_id": {
      "$ref": "../common/definitions.json#/definitions/experiment_id"
    },
    "topology": {
      "$ref": "../common/definitions.json#/definitions/topology"
    },
    "sender_id": {
      "$ref": "../common/definitions.json#/definitions/node_id"
    },
    "recipient_id": {
      "$ref": "../common/definitions.json#/definitions/recipient_id"
    },
    "seq": {
      "$ref": "../common/definitions.json#/definitions/seq"
    },
    "n_features": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "arch_hash": {
      "$ref": "../common/definitions.json#/definitions/sha256"
    },
    "n_samples": {
      "type": "integer",
      "minimum": 1
    }
  }
}
