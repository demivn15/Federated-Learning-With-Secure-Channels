{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fl-benchmark.local/schemas/centralized/register_ack.json",
  "title": "Respuesta al registro",
  "description": "Servidor → cliente.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "msg_type",
    "experiment_id",
    "topology",
    "sender_id",
    "recipient_id",
    "seq",
    "accepted"
  ],
  "properties": {
    "schema_version": {
      "$ref": "../common/definitions.json#/definitions/schema_version"
    },
    "msg_type": {
      "const": "REGISTER_ACK"
    },
    "experiment_id": {
      "$ref": "../common/definitions.json#/definitions/experiment_id"
    },
    "topology": {
      "$ref": "../common/definitions.json#/definitions/topology"
    },
    "sender_id": {
      "$ref": "../common/definitions.json#/definitions/node_id"
    },
    "recipient_id": {
      "$ref": "../common/definitions.json#/definitions/recipient_id"
    },
    "seq": {
      "$ref": "../common/definitions.json#/definitions/seq"
    },
    "accepted": {
      "type": "boolean"
    },
    "reason": {
      "$ref": "../common/definitions.json#/definitions/short_text"
    }
  }
}
