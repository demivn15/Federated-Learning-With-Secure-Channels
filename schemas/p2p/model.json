{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fl-benchmark.local/schemas/p2p/model.json",
  "title": "Modelo local de un par",
  "description": "Par → vecino. Modelo tras entrenar en la ronda `round`, con n y τ para la mezcla ponderada.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "msg_type",
    "experiment_id",
    "topology",
    "sender_id",
    "recipient_id",
    "seq",
    "round",
    "n_samples",
    "tau",
    "metrics",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "$ref": "../common/definitions.json#/definitions/schema_version"
    },
    "msg_type": {
      "const": "MODEL"
    },
    "experiment_id": {
      "$ref": "../common/definitions.json#/definitions/experiment_id"
    },
    "topology": {
      "$ref": "../common/definitions.json#/definitions/topology"
    },
    "sender_id": {
      "$ref": "../common/definitions.json#/definitions/node_id"
    },
    "recipient_id": {
      "$ref": "../common/definitions.json#/definitions/recipient_id"
    },
    "seq": {
      "$ref": "../common/definitions.json#/definitions/seq"
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "n_samples": {
      "type": "integer",
      "minimum": 1
    },
    "tau": {
      "type": "integer",
      "minimum": 1
    },
    "metrics": {
      "$ref": "../common/definitions.json#/definitions/local_metrics"
    },
    "payload": {
      "$ref": "../common/definitions.json#/definitions/payload_descriptor"
    }
  }
}
